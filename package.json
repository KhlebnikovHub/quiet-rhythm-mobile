{
  "name": "quiet-rhythm-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Автономный редактор табулатур для Android, iOS и браузера",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "sync:native": "npm run build:native && cap sync",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.28.2"
  }
}
